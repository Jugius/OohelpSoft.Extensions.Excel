<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <LangVersion>default</LangVersion>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>      
      <AssemblyName>OohelpSoft.Extensions.Excel</AssemblyName>
      <RootNamespace>OohelpSoft.Excel</RootNamespace>
      <Version>1.4.0</Version>      

      <Authors>Andrey Slusarev</Authors>
      <Company>OoHelp.Net</Company>
      <PackageId>$(AssemblyName)</PackageId>
      <Copyright>©2026 Andrey Slusarev (OoHelp.Net)</Copyright>
      <Description>A NuGet library wrapper around EPPlus that simplifies and speeds up common operations with Excel.</Description>
      <PackageProjectUrl>https://github.com/Jugius/OohelpSoft.Extensions.Excel</PackageProjectUrl>
      <RepositoryType>GitHub</RepositoryType>
      <RepositoryUrl>https://github.com/Jugius/OohelpSoft.Extensions.Excel.git</RepositoryUrl>
      <GeneratePackageOnBuild>True</GeneratePackageOnBuild>

      <AnalysisLevel>latest</AnalysisLevel>
      <AnalysisMode>All</AnalysisMode>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
      <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
      <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="EPPlus" Version="8.6.1" />
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectExtension)' != '.dcproj'">
        <PackageReference Include="SonarAnalyzer.CSharp" Version="10.29.0.143774">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
